local function GetVisibility(id, char)
    local t = tick()
    if Visibility_Cache[id] and (t - Visibility_Cache[id].lastUpdate) < 0.1 then return Visibility_Cache[id].isVisible end
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local parts = {
        char:FindFirstChild("Head"), char:FindFirstChild("HumanoidRootPart"),
        char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm"),
        char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm"),
        char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg"),
        char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg"),
    }
    local origin = cam.CFrame.Position
    local vis = false
    for _, p in pairs(parts) do
        if p and p:IsA("BasePart") then
            local r = workspace:Raycast(origin, p.Position - origin, rayParams)
            if r and r.Instance:IsDescendantOf(char) then vis = true break end
        end
    end
    Visibility_Cache[id] = { isVisible = vis, lastUpdate = t }
    return vis
end

local function HideESP(id)
    local c = ESP_Cache[id]
    if not c then return end
    c.Box.Visible = false; c.Text.Visible = false; c.Tracer.Visible = false
end

local function removeChams(id)
    if ChamsObjects[id] then
        for _, obj in pairs(ChamsObjects[id]) do if obj then obj:Destroy() end end
        ChamsObjects[id] = nil
    end
end

local function applyChams(id, char, color)
    if not ChamsObjects[id] then ChamsObjects[id] = {} end
    local e = ChamsObjects[id][1]
    if e and e.Parent == char then
        e.FillColor = color; e.OutlineColor = color; e.Enabled = true
    else
        removeChams(id)
        local hl = Instance.new("Highlight")
        hl.FillColor = color; hl.OutlineColor = color
        hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = char; hl.Parent = char
        ChamsObjects[id] = {hl}
    end
end

