local TabContent = {}

local function GetCurrentTabName()
    for name, frame in pairs(TabContent) do
        if frame.Visible then return name end
    end
    return nil
end

local function CreateTabIfNotExists(name)
    if TabContent[name] then return TabContent[name] end
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 0)
    frame.BackgroundTransparency = 1
    frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.Visible = false
    frame.Parent = ContentScroll
    local l = Instance.new("UIListLayout")
    l.Parent = frame
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Padding = UDim.new(0, 6)
    TabContent[name] = frame
    return frame
end

local function SwitchTab(name)
    for _, frame in pairs(TabContent) do frame.Visible = false end
    local t = TabContent[name]
    if t then t.Visible = true end
end

local function GetTabFrame() return CreateTabIfNotExists(GetCurrentTabName() or "Default") end

