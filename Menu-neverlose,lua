            SilentFOVCircle.Radius = S.SilentFOV; SilentFOVCircle.Color = Color3.fromRGB(255,200,0)
            SilentFOVCircle.Filled = false
            SilentFOVCircle.Position = UserInputService:GetMouseLocation()
            SilentFOVCircle.Visible = true
        end
    end
    
    if S.SilentEnabled then SilentTarget = getSilentTarget() else SilentTarget = nil end
    
    if S.ESPEnabled or S.TracersEnabled or S.ChamsEnabled or S.NPCESPEnabled or S.NPCTracersEnabled or S.NPCChamsEnabled then
        for id in pairs(ESP_Cache) do HideESP(id) end
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and isAlive(p) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then DrawESP(tostring(p.UserId), p.Character, hrp, p.Name, p, false) end
            end
        end
        for npc in pairs(Tracked_NPCs) do
            if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                if hrp then DrawESP(npc, npc, hrp, npc.Name, nil, true) end
            end
        end
    else
        for id in pairs(ESP_Cache) do HideESP(id) end
        for id in pairs(ChamsObjects) do removeChams(id) end
    end
    
    if S.AimbotEnabled then
        local active = false
        if S.AimbotMode == "Hold" then
            local k = S.AimbotKey
            if k == "MouseButton1" then active = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            elseif k == "MouseButton2" then active = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            else active = UserInputService:IsKeyDown(Enum.KeyCode[k]) end
        else active = AimbotToggled end
        if active then
            local t = getClosest(S.FOV)
            if t and t.Character and t.Character:FindFirstChild(S.TargetPart) then
                local part = t.Character[S.TargetPart]
                if S.AimType == "Mouse" and mousemoverel then
                    local mp = UserInputService:GetMouseLocation()
                    local sp = Camera:WorldToViewportPoint(part.Position)
                    mousemoverel((sp.X - mp.X) * (S.Smoothness / 10), (sp.Y - mp.Y) * (S.Smoothness / 10))
                else
                    local cf = CFrame.new(Camera.CFrame.Position, part.Position)
                    Camera.CFrame = Camera.CFrame:Lerp(cf, 1 - S.Smoothness / 10)
                end
            end
        end
    end
    
    if S.LegitEnabled then
        local active = false
        if S.LegitMode == "Hold" then
            local k = S.LegitKey
            if k == "MouseButton1" then active = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            elseif k == "MouseButton2" then active = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            else active = UserInputService:IsKeyDown(Enum.KeyCode[k]) end
        else active = LegitToggled end
        if active then
            local t = getLegitClosest()
            if t and t.Character and t.Character:FindFirstChild(S.TargetPart) then
                local part = t.Character[S.TargetPart]
                local mp = UserInputService:GetMouseLocation()
                local sp = Camera:WorldToViewportPoint(part.Position)
                local dx = (sp.X - mp.X) * (S.LegitSpeed / 100)
                local dy = (sp.Y - mp.Y) * (S.LegitSpeed / 100)
                if mousemoverel then mousemoverel(dx, dy) end
            end
        end
    end
end)

