local function setupSilent()
    if not S.SilentEnabled then return end
    local mt = getrawmetatable and getrawmetatable(game) or debug.getmetatable(game)
    if not mt then return end
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local a = {...}
        if getnamecallmethod() == "Raycast" and self == workspace and S.SilentEnabled then
            if SilentTarget and SilentTarget.Character then
                local tp = SilentTarget.Character:FindFirstChild(S.TargetPart)
                if tp and math.random(1, 100) <= S.SilentHitChance then
                    a[2] = (tp.Position - a[1]).Unit * a[2].Magnitude
                    return old(self, unpack(a))
                end
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end

local TriggerConn = nil
local function toggleTrigger()
    if TriggerConn then TriggerConn:Disconnect() TriggerConn = nil end
    if not S.TriggerEnabled then return end
    TriggerConn = RunService.RenderStepped:Connect(function()
        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        local mp = UserInputService:GetMouseLocation()
        local ray = Camera:ViewportPointToRay(mp.X, mp.Y)
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = {LocalPlayer.Character}
        local res = workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
        if res and res.Instance then
            local hc = res.Instance:FindFirstAncestorOfClass("Model")
            if hc then
                local hp = Players:GetPlayerFromCharacter(hc)
                if hp and hp ~= LocalPlayer then
                    if S.TriggerTeam and LocalPlayer.Team and hp.Team and hp.Team == LocalPlayer.Team then return end
                    if S.TriggerVisible then
                        local tp = hc:FindFirstChild(S.TargetPart)
                        if not tp then return end
                        local rp2 = RaycastParams.new()
                        rp2.FilterType = Enum.RaycastFilterType.Exclude
                        rp2.FilterDescendantsInstances = {LocalPlayer.Character, hc}
                        if workspace:Raycast(Camera.CFrame.Position, tp.Position - Camera.CFrame.Position, rp2) then return end
                    end
                    if S.TriggerDelay > 0 then task.wait(S.TriggerDelay / 1000) end
                    if mouse1press and mouse1release then mouse1press() task.wait() mouse1release() end
                end
            end
        end
    end)
end

local FlyConn, FlyBody, NoclipConn, SpeedConn, JumpConn, InfConn, SpinConn, FBC, AutoJumpConn = nil, nil, nil, nil, nil, nil, nil, nil, nil
local OrigJumpPower = 50

local function updateMovement()
    if FlyConn then FlyConn:Disconnect() FlyConn = nil end
    if NoclipConn then NoclipConn:Disconnect() NoclipConn = nil end
    if SpeedConn then SpeedConn:Disconnect() SpeedConn = nil end
    if JumpConn then JumpConn:Disconnect() JumpConn = nil end
    if InfConn then InfConn:Disconnect() InfConn = nil end
    if SpinConn then SpinConn:Disconnect() SpinConn = nil end
    if FBC then FBC:Disconnect() FBC = nil end
    if AutoJumpConn then AutoJumpConn:Disconnect() AutoJumpConn = nil end
    if FlyBody then FlyBody:Destroy() FlyBody = nil end

    if S.FlyEnabled then
        FlyConn = RunService.Heartbeat:Connect(function(dt)
            local root = getRoot()
            if not root then return end
            if not FlyBody or FlyBody.Parent == nil then
                FlyBody = Instance.new("BodyVelocity")
                FlyBody.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                FlyBody.Parent = root
            end
            local m = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then m = m + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then m = m - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then m = m - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then m = m + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then m = m + Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then m = m - Vector3.new(0,1,0) end
            FlyBody.Velocity = m.Magnitude > 0 and m.Unit * S.FlySpeed * 10 or Vector3.new(0,0,0)
            root.Velocity = Vector3.new(0,0,0)
        end)
    end
    if S.NoclipEnabled then
        NoclipConn = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if char then for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
        end)
    end
    if S.SpeedEnabled then
        SpeedConn = RunService.RenderStepped:Connect(function()
            local h = getHumanoid() if h then h.WalkSpeed = S.SpeedValue end
        end)
    else
        local h = getHumanoid() if h then h.WalkSpeed = 16 end
    end
    if S.JumpPowerEnabled then
        local h = getHumanoid()
        if h then OrigJumpPower = h.JumpPower h.JumpPower = S.JumpPowerValue end
        JumpConn = LocalPlayer.CharacterAdded:Connect(function() task.wait(0.5) local h2 = getHumanoid() if h2 then h2.JumpPower = S.JumpPowerValue end end)
    else
        local h = getHumanoid() if h then h.JumpPower = OrigJumpPower end
    end
    if S.InfJumpEnabled then
        InfConn = RunService.RenderStepped:Connect(function()
            if not UserInputService:IsKeyDown(Enum.KeyCode.Space) then return end
            local h = getHumanoid()
            if h and h:GetState() ~= Enum.HumanoidStateType.Jumping then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    end
    if S.SpinEnabled then
        SpinConn = RunService.RenderStepped:Connect(function()
            local root = getRoot()
            if root then root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(S.SpinSpeed) * 0.1, 0) end
        end)
    end
    if S.FullBrightEnabled then
        FBC = RunService.RenderStepped:Connect(function()
            Lighting.Brightness = 2
            Lighting.Ambient = Color3.fromRGB(255,255,255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
        end)
    else
        Lighting.Brightness = OriginalBrightness
        Lighting.Ambient = OriginalAmbient
        Lighting.OutdoorAmbient = OriginalOutdoorAmbient
    end
    if S.AutoJumpEnabled then
        AutoJumpConn = RunService.RenderStepped:Connect(function()
            local h = getHumanoid()
            if h and h.FloorMaterial ~= Enum.Material.Air then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    end
end

local function isCoin(obj)
    if not obj then return false end
    if obj.Name:lower():find("coin") then
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Model") or obj:IsA("UnionOperation") then return true end
    end
    return false
end

local function getCoinPos(c)
    if c:IsA("BasePart") or c:IsA("MeshPart") or c:IsA("UnionOperation") then return c.Position end
    if c:IsA("Model") then
        local p = c.PrimaryPart or c:FindFirstChildWhichIsA("BasePart")
        return p and p.Position
    end
    return nil
end

local function toggleAutoFarm()
    if AutoFarmRunning then return end
    AutoFarmRunning = true
    task.spawn(function()
        while S.AutoFarmEnabled do
            local char = LocalPlayer.Character
            if not char then task.wait(1) continue end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then task.wait(1) continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then task.wait(1) continue end
            local coins = {}
            local areas = {}
            if workspace:FindFirstChild("Map") then table.insert(areas, workspace.Map) end
            if workspace:FindFirstChild("Debris") then table.insert(areas, workspace.Debris) end
            if #areas == 0 then areas = {workspace} end
            for _, a in pairs(areas) do
                for _, o in pairs(a:GetDescendants()) do
                    if isCoin(o) then table.insert(coins, o) end
                end
            end
            if #coins == 0 then task.wait(1) continue end
            local closest, closestPos, closestDist = nil, nil, math.huge
            for _, c in pairs(coins) do
                local p = getCoinPos(c)
                if p then
                    local d = (p - root.Position).Magnitude
                    if d < closestDist then closestDist = d closest = c closestPos = p end
                end
            end
            if closestPos then
                root.CFrame = CFrame.new(closestPos)
                task.wait(S.AutoFarmTPDelay)
                task.wait(S.AutoFarmDelay)
            else task.wait(0.5) end
        end
        AutoFarmRunning = false
    end)
end

