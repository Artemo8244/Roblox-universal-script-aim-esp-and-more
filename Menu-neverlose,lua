local function getColor(player, isNPC, visible)
    if isNPC then
        if S.ESPIgnoreWalls then return Color3.fromRGB(0, 200, 255) end
        return visible and Color3.fromRGB(0, 200, 255) or Color3.fromRGB(200, 0, 255)
    end
    if player and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return Color3.fromRGB(0, 255, 0)
    end
    if isMM2() and player and MM2Roles[player] then
        local r = MM2Roles[player]
        if r == "Murderer" then return Color3.fromRGB(255, 50, 50) end
        if r == "Sheriff" then return Color3.fromRGB(50, 150, 255) end
        if r == "Innocent" then return Color3.fromRGB(50, 255, 50) end
    end
    if S.ESPIgnoreWalls then
        if player and player.Team and player.Team.TeamColor then return player.Team.TeamColor.Color end
        return Color3.fromRGB(0, 255, 0)
    end
    if player and player.Team and player.Team.TeamColor then
        local c = player.Team.TeamColor.Color
        if not visible then c = Color3.new(c.R * 0.5, c.G * 0.5, c.B * 0.5) end
        return c
    end
    return visible and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
end

local function DrawESP(id, char, hrp, name, player, isNPC)
    local showBox = isNPC and S.NPCESPEnabled or (not isNPC and S.ESPEnabled)
    local showTracer = isNPC and S.NPCTracersEnabled or (not isNPC and S.TracersEnabled)
    local showChams = isNPC and S.NPCChamsEnabled or (not isNPC and S.ChamsEnabled)
    if not showBox and not showTracer and not showChams then removeChams(id) return end
    
    local cam = workspace.CurrentCamera
    if not cam then return end
    local dist = (cam.CFrame.Position - hrp.Position).Magnitude
    if dist == 0 then return end
    local rootScreen, onScreen = cam:WorldToViewportPoint(hrp.Position)
    local visible = GetVisibility(id, char)
    local color = getColor(player, isNPC, visible)
    
    if showChams then applyChams(id, char, color) else removeChams(id) end
    if not onScreen then return end
    
    if not ESP_Cache[id] then
        ESP_Cache[id] = { Box = Drawing.new("Square"), Text = Drawing.new("Text"), Tracer = Drawing.new("Line") }
        ESP_Cache[id].Box.Thickness = 1.5; ESP_Cache[id].Box.Filled = false
        ESP_Cache[id].Text.Size = 14; ESP_Cache[id].Text.Center = true; ESP_Cache[id].Text.Outline = true
        ESP_Cache[id].Tracer.Thickness = 1.5
    end
    
    local box, text, tracer = ESP_Cache[id].Box, ESP_Cache[id].Text, ESP_Cache[id].Tracer
    local top = cam:WorldToViewportPoint(hrp.Position + ESP_CONFIG.TOP_OFFSET)
    local bot = cam:WorldToViewportPoint(hrp.Position - ESP_CONFIG.BOTTOM_OFFSET)
    local h = math.abs(bot.Y - top.Y)
    local w = h / 2
    if h < ESP_CONFIG.MIN_HEIGHT then h = ESP_CONFIG.MIN_HEIGHT; w = ESP_CONFIG.MIN_WIDTH end
    
    if showBox then
        box.Size = Vector2.new(w, h)
        box.Position = Vector2.new(rootScreen.X - w/2, top.Y)
        box.Color = color
        box.Visible = true
        text.Text = string.format("%s%s [%dm]", isNPC and "[NPC] " or "", name, math.floor(dist / ESP_CONFIG.DISTANCE_DIVISOR))
        text.Position = Vector2.new(rootScreen.X, top.Y - 18)
        text.Color = color
        text.Visible = true
    end
    if showTracer then
        tracer.From = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y)
        tracer.To = Vector2.new(rootScreen.X, bot.Y)
        tracer.Color = color
        tracer.Visible = true
    end
end

local function updateMM2()
    if not isMM2() then return end
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        if not isAlive(p) then MM2Roles[p] = nil continue end
        local eq = p.Character:FindFirstChildOfClass("Tool")
        if eq then
            local n = eq.Name:lower()
            if n:find("knife") then MM2Roles[p] = "Murderer"
            elseif n:find("revolver") or n:find("gun") or n:find("bow") then MM2Roles[p] = "Sheriff" end
        end
    end
end

